      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U2" name="Chọn link, duyệt đề xuất">
